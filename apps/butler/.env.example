# 이 파일을 같은 폴더에 .env로 복사해서 쓴다. 값은 /api/v1로 끝난다(api-convention.md).
VITE_SERVER_API_URL=http://localhost:4000/api/v1

# 권리자 인증 전 본인인증(B팀, 포트원 V2 · KG이니시스 통합인증). 포트원 관리자 콘솔 › 결제 연동 › 연동 정보에서 확인한다.
# 브라우저에 공개되는 값이다(비밀값 아님). 비어 있으면 인증 시작 때 "본인인증을 준비 중이에요"로 안내하고 진행하지 않는다.
VITE_PORTONE_STORE_ID=
VITE_PORTONE_IDENTITY_CHANNEL_KEY=
