generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// id·FK는 uuid 타입(@db.Uuid), 시각은 timestamptz(UTC, @db.Timestamptz(3))로 저장한다.
// Prisma로 표현하지 못하는 부분 인덱스·제약(uq_ownership_active_user, uq_ownership_verified,
// ix_jobs_pending, ex_contract_period, ix_documents_unattached)은 마이그레이션 SQL에 직접 넣었다(노션 6번 16장).
// 이름 규칙은 노션 6번 2장을 따른다.

enum Role {
  LANDLORD
  TENANT
  ADMIN

  @@map("role")
}

// 소셜 로그인 제공자
enum OAuthProvider {
  GOOGLE
  KAKAO

  @@map("oauth_provider")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN

  @@map("user_status")
}

// 소유 관계 인증 상태. EXPIRED는 여기 없다 — verificationExpiresAt이 지나면
// 응답을 만들 때 계산해서 EXPIRED로 내려준다 (src/platform/ownershipStatus.js)
enum VerificationStatus {
  UNVERIFIED
  VERIFIED
  REVOKED

  @@map("verification_status")
}

enum EndReason {
  SELF_ENDED
  SUPERSEDED
  ADMIN_ENDED
  SOLD
  UNVERIFIED_EXPIRED

  @@map("end_reason")
}

// 권리자 인증 시도 상태. PENDING → RUNNING → VERIFIED | FAILED
enum VerificationAttemptStatus {
  PENDING
  RUNNING
  VERIFIED
  FAILED

  @@map("verification_attempt_status")
}

enum LeaseType {
  MONTHLY
  JEONSE

  @@map("lease_type")
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELED

  @@map("ticket_status")
}

// 오래 걸리는 작업 상태 (노션 5번 API Spec)
enum JobStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED

  @@map("job_status")
}

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique
  // 소셜 로그인으로만 가입한 계정은 비밀번호가 없다(null). 이 경우 비밀번호 로그인은 항상 실패한다.
  passwordHash String?    @map("password_hash")
  name         String
  // 애플리케이션 레벨에서 암호화한 값을 저장한다 (ERD 공통 설계 규칙)
  phone        String?
  // 소유주 인증(이름+생년월일 대조)용. "YYYY-MM-DD"를 phone처럼 암호화해 저장한다. 기존 사용자·시드 계정은 null.
  birthDate    String?    @map("birth_date")
  role         Role
  status       UserStatus @default(ACTIVE)
  // 이메일 소유를 인증번호로 확인한 시각. 인증 도입 전 가입자는 null.
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)

  suspendedAt   DateTime? @map("suspended_at") @db.Timestamptz(3)
  suspendReason String?   @map("suspend_reason") // 어드민이 입력
  withdrawnAt   DateTime? @map("withdrawn_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions          Session[]
  oauthAccounts     OAuthAccount[]
  consents          Consent[]
  requestedJobs     Job[]
  ownerships        Ownership[]
  tenantContracts   Contract[]    @relation("TenantContracts")
  myBuildings       MyBuilding[]
  activities        Activity[]
  requestedTickets  Ticket[]      @relation("RequestedTickets")
  uploads           Upload[]
  uploadedDocuments Document[]    @relation("UploadedDocuments")
  authoredLogs      PropertyLog[] @relation("AuthoredPropertyLogs")
  threadParticipations ThreadParticipant[]
  sentThreadMessages   ThreadMessage[] @relation("SentThreadMessages")

  ownershipVerificationAttempts OwnershipVerificationAttempt[]

  @@map("users")
}

// 로그인 세션. refresh token은 해시만 저장하고 갱신할 때마다 교체한다(rotation, 노션 4번 인증 방식).
// 로그아웃·비밀번호 변경·계정 정지 시 revokedAt을 채운다.
model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  user             User      @relation(fields: [userId], references: [id])
  refreshTokenHash String    @unique @map("refresh_token_hash")
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt       DateTime? @map("last_used_at") @db.Timestamptz(3)
  userAgent        String?   @map("user_agent")
  ip               String?
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("sessions")
}

// 소셜 로그인 연결. 한 사용자가 구글·카카오를 모두 연결할 수 있고, 같은 소셜 계정은 한 사용자에게만 붙는다.
// providerUserId는 제공자가 주는 불변 식별자(구글 sub, 카카오 id)다. 이메일은 바뀔 수 있어 식별에 쓰지 않는다.
model OAuthAccount {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  user           User          @relation(fields: [userId], references: [id])
  provider       OAuthProvider
  providerUserId String        @map("provider_user_id")
  // 연결할 때 제공자가 알려 준 이메일(참고용)
  email          String?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([provider, providerUserId], map: "uq_oauth_accounts_provider_user")
  @@unique([userId, provider], map: "uq_oauth_accounts_user_provider")
  @@map("oauth_accounts")
}

// 회원가입 이메일 인증. 가입 전(users 행이 없을 때)의 이메일이라 userId가 없다.
// 흐름: 인증번호 발송(행 생성) → 번호 확인(verifiedAt·tokenHash 기록, 토큰 발급) → 가입 때 토큰을 한 번 쓰고 consumedAt 기록.
// 인증번호·토큰 원문은 저장하지 않고 해시만 둔다. expiresAt은 번호 확인 전에는 번호 만료, 확인 후에는 토큰 만료다.
model EmailVerification {
  id         String    @id @default(uuid()) @db.Uuid
  email      String
  codeHash   String    @map("code_hash")
  attempts   Int       @default(0)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  tokenHash  String?   @unique @map("token_hash")
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([email, createdAt])
  @@map("email_verifications")
}

// 약관 동의 이력. 지우지 않고 행을 쌓는다(동의/철회마다 새 행 또는 withdrawnAt).
// type: TERMS, PRIVACY_REQUIRED (가입 시 필수). version은 동의한 약관 버전.
model Consent {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id])
  type        String
  version     String
  agreed      Boolean
  agreedAt    DateTime  @map("agreed_at") @db.Timestamptz(3)
  withdrawnAt DateTime? @map("withdrawn_at") @db.Timestamptz(3)
  ip          String?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId])
  @@map("consents")
}

// 법정동. 행정안전부 "법정동코드 전체자료"로 셋업 시점에 시딩한다(prisma/seed.js).
// 조회 API에서 Region을 만드는 경로는 없다 — lazy 생성하지 않는다.
model Region {
  id          String  @id // 법정동코드 10자리
  sidoName    String  @map("sido_name")
  sigunguName String  @map("sigungu_name")
  dongName    String  @map("dong_name")
  fullName    String  @map("full_name")
  isActive    Boolean @default(true) @map("is_active") // 폐지된 동은 false

  complexes Complex[]

  @@map("regions")
}

model Complex {
  id           String  @id @default(uuid()) @db.Uuid
  // juso 도로명주소에서 만든 결정적 키 "ROAD:<도로명코드12>-<지하0/1>-<건물본번>-<건물부번>".
  // 불투명 값이라 도로명이 바뀌어도 고치지 않는다(대표 건물관리번호로 다시 찾는다).
  sourceKey    String? @unique @map("source_key")
  name         String
  jibunAddress String? @map("jibun_address")
  roadAddress  String? @map("road_address")
  regionId     String  @map("region_id")
  region       Region  @relation(fields: [regionId], references: [id])

  // juso 검색 결과에서 온 주소 칸. 관리자가 만든 단지는 비어 있을 수 있다.
  zipCode        String?  @map("zip_code") @db.VarChar(5)
  buildingName   String?  @map("building_name") @db.VarChar(100) // juso bdNm
  dongNames      String[] @default([]) @map("dong_names") // juso detBdNmList(예: 101동~105동)
  roadCode       String?  @map("road_code") @db.VarChar(12) // 도로명코드(rnMgtSn)
  isUnderground  Boolean? @map("is_underground")
  buildingMainNo Int?     @map("building_main_no")
  buildingSubNo  Int?     @map("building_sub_no")
  sigunguCode    String?  @map("sigungu_code") @db.VarChar(5)
  roadName       String?  @map("road_name") @db.VarChar(80) // rn 원문
  // toRoadNameKey(roadName). 앱이 채우는 일반 칸(생성 칸 아님). K-apt 연결 표와 비교하는 텍스트 키.
  roadNameKey    String?  @map("road_name_key")
  isMountain     Boolean? @map("is_mountain")
  mainLot        Int?     @map("main_lot")
  subLot         Int?     @map("sub_lot")
  // 대표 건물관리번호(bdMgtSn). 도로명이 바뀐 주소를 기존 단지로 다시 찾을 때 쓴다.
  buildingMgtNo  String?  @map("building_mgt_no") @db.VarChar(25)
  // 연결 표(kapt_address_links·juso_building_links)에서만 정해진다. 사용자 입력 아님.
  kaptCode       String?  @map("kapt_code") @db.VarChar(20)

  // buildingInfo — 외부 데이터에 없으면 전부 null. AMI 등 나중 기능이 입력으로 씀.
  // 응답의 buildingInfo 객체로 묶어 내려주고, 다섯 값이 모두 null이면 buildingInfo: null.
  approvalDate   DateTime? @map("approval_date") @db.Date
  householdCount Int?      @map("household_count")
  buildingCount  Int?      @map("building_count")
  maxFloor       Int?      @map("max_floor")
  parkingCount   Int?      @map("parking_count")

  createdByAdmin Boolean @default(false) @map("created_by_admin")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  properties  Property[]
  myBuildings MyBuilding[]

  @@index([sigunguCode, roadNameKey, isUnderground, buildingMainNo, buildingSubNo])
  @@index([buildingMgtNo])
  @@index([kaptCode])
  @@map("complexes")
}

// 임대인 개인 건물 설정(임대인 × 단지). 건물명·정원·메모. 상태는 저장하지 않는다.
// 한 임대인이 같은 단지(도로명주소)에 설정을 두 개 만들 수 없다(정원을 단지 단위로 센다).
model MyBuilding {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  user      User      @relation(fields: [userId], references: [id])
  complexId String    @map("complex_id") @db.Uuid
  complex   Complex   @relation(fields: [complexId], references: [id])
  name      String    @db.VarChar(50)
  capacity  Int? // 전체 호실 수 1~999. null이면 정원 검사 안 함
  memo      String?   @db.VarChar(500)
  // 건물 삭제는 숨김이다(행은 남김). 예전 소유 호실을 내가 붙인 이름으로 계속 보여 주고,
  // 같은 주소로 다시 등록하면 이 행을 되살린다(@@unique userId+complexId는 그대로).
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([userId, complexId])
  @@index([complexId])
  @@map("my_buildings")
}

// 최근 활동(사용자별). 문장은 저장하지 않고 화면이 type + params로 만든다.
// complexId·propertyId는 FK 없이 값만 둔다(대상이 지워져도 기록은 남김).
model Activity {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  type       String   @db.VarChar(40)
  complexId  String?  @map("complex_id") @db.Uuid
  propertyId String?  @map("property_id") @db.Uuid
  params     Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([userId, createdAt(sort: Desc)])
  @@map("activities")
}

// 외부 API 하루 호출 수(KST 날짜). K-apt 목록·기본정보 API만 센다(juso는 세지 않음).
model ApiUsage {
  api       String   @db.VarChar(30)
  usageDate DateTime @map("usage_date") @db.Date
  count     Int      @default(0)

  @@id([api, usageDate])
  @@map("api_usages")
}

// K-apt(공동주택관리정보시스템) 전국 단지 목록 캐시. 매주 Vercel Cron(GET /api/cron/kapt-complexes)과
// `npm run sync:kapt`가 채운다(src/domains/complexes/kaptSync.js). 목록에서 빠진 단지는
// 지우지 않고 isActive=false로만 바꾼다. 단지(Complex)와는 연결 표를 거쳐 kaptCode로만 이어진다.
model KaptComplex {
  kaptCode      String   @id @map("kapt_code") @db.VarChar(20)
  name          String
  // K-apt bjdCode 원본(리 단위일 수 있음). regions FK는 걸지 않는다.
  legalDongCode String   @map("legal_dong_code") @db.VarChar(10)
  sidoName      String?  @map("sido_name")
  sigunguName   String?  @map("sigungu_name")
  dongName      String?  @map("dong_name")
  riName        String?  @map("ri_name")
  isActive      Boolean  @default(true) @map("is_active")
  // 마지막 동기화에서 목록에 있었던 시각
  syncedAt      DateTime @map("synced_at") @db.Timestamptz(3)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  // K-apt 기본정보(엑셀 또는 getAphusBassInfoV5) 값. 도로명 키는 연결 표(kapt_address_links)에만 둔다.
  roadAddress    String?   @map("road_address") // doroJuso 원문
  jibunAddress   String?   @map("jibun_address") // kaptAddr 원문
  // kaptAddr 번지
  mainLot        Int?      @map("main_lot")
  subLot         Int?      @map("sub_lot")
  saleType       String?   @map("sale_type") @db.VarChar(20) // 분양형태(분양·임대·혼합 등)
  householdCount Int?      @map("household_count")
  buildingCount  Int?      @map("building_count")
  approvalDate   DateTime? @map("approval_date") @db.Date
  basisSource    String?   @map("basis_source") @db.VarChar(10) // EXCEL / API
  basisFileDate  DateTime? @map("basis_file_date") @db.Date
  // null이면 아직 기본정보를 못 받음. 실패마다 basisAttempts +1, 3회 이상이면 자동 채우기 대상에서 뺀다.
  basisFetchedAt DateTime? @map("basis_fetched_at") @db.Timestamptz(3)
  basisAttempts  Int       @default(0) @map("basis_attempts")
  basisError     String?   @map("basis_error")

  @@index([legalDongCode])
  @@index([legalDongCode, mainLot])
  @@map("kapt_complexes")
}

// K-apt 쪽이 알려 준 도로명주소(엑셀·기본정보 API). 키는 kaptAddress.js의
// parseRoadAddress()·toRoadNameKey() 규칙. 소스별로 mark-and-sweep(import_run_id).
model KaptAddressLink {
  source          String   @db.VarChar(20) // KAPT_EXCEL / KAPT_API
  roadSigunguCd   String   @map("road_sigungu_cd") @db.VarChar(5)
  roadNameKey     String   @map("road_name_key")
  roadUnderground Boolean  @map("road_underground")
  roadMainNo      Int      @map("road_main_no")
  roadSubNo       Int      @map("road_sub_no")
  kaptCode        String   @map("kapt_code") @db.VarChar(20)
  importRunId     String?  @map("import_run_id") @db.Uuid
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@id([source, roadSigunguCd, roadNameKey, roadUnderground, roadMainNo, roadSubNo, kaptCode])
  @@index([roadSigunguCd, roadNameKey, roadUnderground, roadMainNo, roadSubNo])
  @@index([kaptCode])
  @@map("kapt_address_links")
}

// juso 건물DB의 건물(동)별 K-apt 연결. 변동분이 건물관리번호 단위로 오므로 건물 단위로 둔다.
// K-apt 단지와 맞은 건물만 저장한다. 같은 필지 형제 조회용 식 인덱스
// (substr(building_mgt_no, 1, 19))는 마이그레이션 SQL에 있다.
model JusoBuildingLink {
  buildingMgtNo   String    @id @map("building_mgt_no") @db.VarChar(25)
  roadSigunguCd   String    @map("road_sigungu_cd") @db.VarChar(5)
  roadNameKey     String    @map("road_name_key")
  roadUnderground Boolean   @map("road_underground")
  roadMainNo      Int       @map("road_main_no")
  roadSubNo       Int       @map("road_sub_no")
  roadCode        String?   @map("road_code") @db.VarChar(12)
  kaptCode        String    @map("kapt_code") @db.VarChar(20)
  matchRule       String    @map("match_rule") @db.VarChar(20) // ROAD_KEY / LOT / NON_APT_FLAG
  importRunId     String?   @map("import_run_id") @db.Uuid
  appliedFileDate DateTime? @map("applied_file_date") @db.Date
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([roadSigunguCd, roadNameKey, roadUnderground, roadMainNo, roadSubNo])
  @@index([kaptCode])
  @@map("juso_building_links")
}

// 참고 데이터 가져오기 실행 기록이자 실행 단위 잠금.
// 부분 유니크 (lock_key) WHERE status='RUNNING', (source, file_date) WHERE status='SUCCEEDED'
// AND source IN ('JUSO_DELTA','JUSO_LINK')는 마이그레이션 SQL에 있다.
model DataImport {
  id          String    @id @default(uuid()) @db.Uuid
  source      String    @db.VarChar(20) // KAPT_EXCEL / JUSO_FULL / JUSO_LINK / KAPT_API_BASIS
  lockKey     String    @map("lock_key") @db.VarChar(100)
  fileName    String?   @map("file_name")
  fileDate    DateTime? @map("file_date") @db.Date
  fileSize    BigInt?   @map("file_size")
  fileSha1    String?   @map("file_sha1") @db.Char(40)
  status      String    @db.VarChar(10) // RUNNING / PARTIAL / SUCCEEDED / FAILED
  rowsRead    Int       @default(0) @map("rows_read")
  rowsWritten Int       @default(0) @map("rows_written")
  cursorLine  Int       @default(0) @map("cursor_line")
  stats       Json?
  error       String?
  startedAt   DateTime  @default(now()) @map("started_at") @db.Timestamptz(3)
  finishedAt  DateTime? @map("finished_at") @db.Timestamptz(3)

  @@index([source, status, fileDate])
  @@map("data_imports")
}

// 단지 검색 결과 저장본(아직 단지가 없는 결과만). resolve가 24시간 안의 행으로 단지를 만든다.
model AddressCache {
  sourceKey String   @id @map("source_key") @db.VarChar(50)
  payload   Json
  fetchedAt DateTime @default(now()) @map("fetched_at") @db.Timestamptz(3)

  @@index([fetchedAt])
  @@map("address_caches")
}

model Property {
  id            String   @id @default(uuid()) @db.Uuid
  complexId     String   @map("complex_id") @db.Uuid
  complex       Complex  @relation(fields: [complexId], references: [id])
  buildingNo    String   @map("building_no") @db.VarChar(10)
  unitNo        String   @map("unit_no") @db.VarChar(10)
  exclusiveArea Decimal? @map("exclusive_area") @db.Decimal(8, 2)
  floor         Int?
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  ownerships Ownership[]
  tickets    Ticket[]
  logs       PropertyLog[]

  // 같은 단지·동·호는 한 Property로 합친다(POST /properties가 이 키로 찾아 재사용).
  @@unique([complexId, buildingNo, unitNo])
  @@map("properties")
}

model Ownership {
  id         String   @id @default(uuid()) @db.Uuid
  propertyId String   @map("property_id") @db.Uuid
  property   Property @relation(fields: [propertyId], references: [id])
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id])

  acquiredYearMonth String? @map("acquired_year_month")
  purchasePrice     BigInt? @map("purchase_price")

  verificationStatus    VerificationStatus @default(UNVERIFIED) @map("verification_status")
  verifiedAt            DateTime?          @map("verified_at") @db.Timestamptz(3)
  verificationExpiresAt DateTime?          @map("verification_expires_at") @db.Timestamptz(3)

  // 등기부 증빙 문서
  evidenceDocumentId String?   @map("evidence_document_id") @db.Uuid
  evidenceDocument   Document? @relation(fields: [evidenceDocumentId], references: [id])
  // 권리자 인증 피처의 OwnershipCheck.id. 피처 테이블이라 FK 없이 값만 둔다.
  checkId            String?   @map("check_id")

  // 같은 호실에 내 활성 소유 관계(endedAt null)는 1개 — uq_ownership_active_user (마이그레이션 SQL)
  startedAt DateTime   @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt   DateTime?  @map("ended_at") @db.Timestamptz(3)
  endReason EndReason? @map("end_reason")
  endNote   String?    @map("end_note")

  // 내 임대 조건(사용자별). 값은 JS 상수 UNIT_TYPES·EQUIPMENT_CODES로 검사한다(enum 아님).
  unitType     String?  @map("unit_type") @db.VarChar(20)
  equipment    String[] @default([]) @db.VarChar(30)
  equipmentEtc String?  @map("equipment_etc") @db.VarChar(200)

  contracts Contract[]
  tickets   Ticket[]
  logs      PropertyLog[]

  verificationAttempts OwnershipVerificationAttempt[]

  @@index([propertyId])
  @@index([userId])
  @@map("ownerships")
}

model Contract {
  id          String    @id @default(uuid()) @db.Uuid
  ownershipId String    @map("ownership_id") @db.Uuid
  ownership   Ownership @relation(fields: [ownershipId], references: [id])

  // 임차인이 초대를 수락하기 전까지 tenantId는 null. tenantName/tenantPhone은
  // 임대인이 등록 시점에 입력하는 값이라 계정과 별개로 항상 저장한다.
  tenantId    String? @map("tenant_id") @db.Uuid
  tenant      User?   @relation("TenantContracts", fields: [tenantId], references: [id])
  tenantName  String  @map("tenant_name")
  tenantPhone String  @map("tenant_phone")

  leaseType      LeaseType @map("lease_type")
  deposit        BigInt
  monthlyRent    BigInt    @map("monthly_rent")
  // 월세 입금일(매월 며칠). 1~31, 31은 "말일". 전세·입력 전 계약은 null.
  rentPaymentDay Int?      @map("rent_payment_day")

  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date

  // status는 저장하지 않는다 — terminatedOn 유무 + 오늘(KST) 날짜로 응답마다 계산한다.
  // (src/platform/contractStatus.js의 computeContractStatus 참고)
  terminatedOn      DateTime? @map("terminated_on") @db.Date
  terminationReason String?   @map("termination_reason")

  previousContractId String? @map("previous_contract_id") @db.Uuid
  memo               String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tickets Ticket[]

  // 같은 소유 관계 안에서 해지 안 된 계약끼리 기간 겹침 금지 — ex_contract_period (마이그레이션 SQL)
  @@index([ownershipId])
  @@index([tenantId])
  @@map("contracts")
}

// 수리·점검 요청 (노션 6번 10장, 계약 5장).
// category는 등록형 문자열(REPAIR, INSPECTION, OTHER, 피처가 추가)이라 enum이 아니다.
// 관리 로그(하우스 로그, 계약 5장). API 경로·활동·감사 이름은 management-logs·MANAGEMENT_LOG_*를 쓴다.
enum PropertyLogScope {
  PRIVATE
  PROPERTY_HISTORY

  @@map("property_log_scope")
}

model PropertyLog {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @map("property_id") @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id])
  // 작성 당시 소유 관계. 이 관계가 끝나면 기록은 읽기 전용이 된다.
  ownershipId String    @map("ownership_id") @db.Uuid
  ownership   Ownership @relation(fields: [ownershipId], references: [id])
  // 시스템이 만든 기록은 null
  authorId    String?   @map("author_id") @db.Uuid
  author      User?     @relation("AuthoredPropertyLogs", fields: [authorId], references: [id])

  scope      PropertyLogScope
  type       String           @db.VarChar(30) // REPAIR, INSPECTION, NOTE, TICKET_SUMMARY(등록형)
  title      String           @db.VarChar(100)
  content    String?
  occurredOn DateTime         @map("occurred_on") @db.Date
  cost       BigInt?

  // 응답의 source. 직접 쓴 기록은 platform + null, 시스템 기록은 만든 곳을 가리킨다.
  sourceFeature      String  @default("platform") @map("source_feature") @db.VarChar(40)
  sourceResourceType String? @map("source_resource_type") @db.VarChar(40)
  sourceResourceId   String? @map("source_resource_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  tickets Ticket[]

  @@index([propertyId, scope, occurredOn(sort: Desc)])
  @@index([ownershipId, occurredOn(sort: Desc)])
  @@index([authorId, occurredOn(sort: Desc)])
  @@map("property_logs")
}

model Ticket {
  id          String    @id @default(uuid()) @db.Uuid
  propertyId  String    @map("property_id") @db.Uuid
  property    Property  @relation(fields: [propertyId], references: [id])
  // 처리할 소유 관계. 임차인이 만들면 그 계약의 소유 관계, 임대인이 만들면 본인 활성 소유 관계.
  ownershipId String    @map("ownership_id") @db.Uuid
  ownership   Ownership @relation(fields: [ownershipId], references: [id])
  // 임차인이 요청했을 때의 계약. 임대인이 만들면 null.
  contractId  String?   @map("contract_id") @db.Uuid
  contract    Contract? @relation(fields: [contractId], references: [id])
  requesterId String    @map("requester_id") @db.Uuid
  requester   User      @relation("RequestedTickets", fields: [requesterId], references: [id])

  category       String       @db.VarChar(30)
  title          String
  description    String
  status         TicketStatus @default(OPEN)
  resolutionNote String?      @map("resolution_note")
  cost           BigInt? // 임대인에게만 보인다
  // DONE이 되면 자동 생성되는 TICKET_SUMMARY 관리 로그(응답의 historyLogId).
  logId          String?      @map("log_id") @db.Uuid
  log            PropertyLog? @relation(fields: [logId], references: [id])
  closedAt       DateTime?    @map("closed_at") @db.Timestamptz(3) // DONE·CANCELED가 된 시각

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([propertyId])
  @@index([ownershipId])
  @@index([contractId])
  @@index([requesterId])
  @@map("tickets")
}

// 임대인·임차인 소통 스레드(계약 6장). 계약·티켓 하나에 스레드 하나.
// 붙는 곳은 contextType + contextId 다형 참조라 FK가 없다(Document와 같은 방식).
// contextType은 등록형 문자열(CONTRACT, TICKET, 피처가 추가)이라 enum이 아니다.
model Thread {
  id          String @id @default(uuid()) @db.Uuid
  contextType String @map("context_type") @db.VarChar(40)
  contextId   String @map("context_id") @db.Uuid

  // 마지막 메시지 시각(목록의 "최근 메시지 순"). 메시지가 없으면 null.
  lastMessageAt DateTime? @map("last_message_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  participants ThreadParticipant[]
  messages     ThreadMessage[]

  @@unique([contextType, contextId])
  @@map("threads")
}

// 스레드 참여자(임대인·임차인 2명). 참여자는 서버가 정하고, 읽은 위치를 사람마다 둔다.
model ThreadParticipant {
  id       String @id @default(uuid()) @db.Uuid
  threadId String @map("thread_id") @db.Uuid
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId   String @map("user_id") @db.Uuid
  user     User   @relation(fields: [userId], references: [id])

  // 마지막으로 읽은 메시지. 안 읽은 수는 이 메시지 다음의 상대 메시지 수다.
  lastReadMessageId String?   @map("last_read_message_id") @db.Uuid
  lastReadAt        DateTime? @map("last_read_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_participants")
}

// 메시지. 수정·삭제하지 않는다. 운영자가 숨기면 isHidden(응답 body는 null).
model ThreadMessage {
  id       String @id @default(uuid()) @db.Uuid
  threadId String @map("thread_id") @db.Uuid
  thread   Thread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId String @map("sender_id") @db.Uuid
  sender   User   @relation("SentThreadMessages", fields: [senderId], references: [id])

  body     String
  isHidden Boolean   @default(false) @map("is_hidden")
  hiddenAt DateTime? @map("hidden_at") @db.Timestamptz(3)

  // 응답의 sentAt. 커서(createdAt desc, id desc)에 쓴다.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([threadId, createdAt])
  @@map("thread_messages")
}

// 업로드 세션 (노션 6번 12장, 계약 6장 POST /files/upload-sessions).
// 세션 발급 → 브라우저가 Storage 서명 URL로 직접 업로드 → POST /documents로 문서 등록.
model Upload {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  user        User      @relation(fields: [userId], references: [id])
  fileName    String    @map("file_name")
  mimeType    String    @map("mime_type") // JPEG, PNG, WEBP, HEIC, PDF
  sizeBytes   BigInt    @map("size_bytes") // 최대 20MB
  // documentType(CONTRACT_DOCUMENT, REGISTRY_CERTIFICATE, PHOTO, OTHER). 등록형 문자열.
  type        String    @db.VarChar(40)
  storagePath String    @map("storage_path")
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(3)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  document Document?

  @@index([userId])
  @@map("uploads")
}

// 등록된 문서 (노션 6번 12장). 붙는 곳은 resourceType + resourceId 다형 참조라 FK가 없다.
// resourceType이 null이면 미연결 문서 — 24시간 안에 안 붙으면 정리한다(ix_documents_unattached, 마이그레이션 SQL).
model Document {
  id           String    @id @default(uuid()) @db.Uuid
  uploadId     String    @unique @map("upload_id") @db.Uuid
  upload       Upload    @relation(fields: [uploadId], references: [id])
  uploaderId   String    @map("uploader_id") @db.Uuid
  uploader     User      @relation("UploadedDocuments", fields: [uploaderId], references: [id])
  type         String    @db.VarChar(40) // documentType, Upload.type과 같은 값
  // PROPERTY, OWNERSHIP, CONTRACT, TICKET, MANAGEMENT_LOG, THREAD_MESSAGE 등(등록형)
  resourceType String?   @map("resource_type") @db.VarChar(40)
  resourceId   String?   @map("resource_id") @db.Uuid
  storagePath  String    @map("storage_path")
  fileName     String    @map("file_name")
  mimeType     String    @map("mime_type")
  sizeBytes    BigInt    @map("size_bytes")
  // 이력 승계된 문서·인증 증빙은 잠근다(삭제 불가, 계약 6장 DOCUMENT_NOT_DELETABLE).
  isLocked     Boolean   @default(false) @map("is_locked")
  attachedAt   DateTime? @map("attached_at") @db.Timestamptz(3)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  evidenceFor Ownership[]

  @@index([resourceType, resourceId])
  @@index([uploaderId])
  @@map("documents")
}

// 오래 걸리는 작업 (노션 5번 API Spec 6장 jobs.enqueue()).
// type은 등록형 문자열(MARKET_COLLECT 등, 피처는 접두어)이라 enum이 아니다.
// 대기 작업 조회용 부분 인덱스 ix_jobs_pending은 마이그레이션 SQL에 있다.
model Job {
  id            String    @id @default(uuid()) @db.Uuid
  type          String
  status        JobStatus @default(PENDING)
  payload       Json?
  result        Json?
  error         Json?
  // 시스템이 만든 작업은 null
  requestedById String?   @map("requested_by_id") @db.Uuid
  requestedBy   User?     @relation(fields: [requestedById], references: [id])
  attempts      Int       @default(0)
  runAfter      DateTime  @default(now()) @map("run_after") @db.Timestamptz(3)
  lockedAt      DateTime? @map("locked_at") @db.Timestamptz(3) // 워커 중복 실행 방지
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([requestedById])
  @@map("jobs")
}

// 감사 로그를 남긴 주체. 시스템 작업(cron 등)은 SYSTEM이고 actorId가 null이다.
enum AuditActorType {
  USER
  SYSTEM

  @@map("audit_actor_type")
}

// 감사 로그(노션 5번 API Spec 8·10장). 쓰기는 src/platform/audit.js의 audit.record()로만 하고 수정·삭제하지 않는다.
// action·resourceType은 피처 접두어를 붙여 값을 늘리는 등록형이라 enum이 아니라 문자열이다.
// resourceType + resourceId로 아무 리소스나 가리키므로 FK가 없다(대상이 지워져도 기록은 남김).
model AuditLog {
  id           String         @id @default(uuid()) @db.Uuid
  actorType    AuditActorType @map("actor_type")
  actorId      String?        @map("actor_id") @db.Uuid
  action       String         @db.VarChar(60)
  resourceType String         @map("resource_type") @db.VarChar(40)
  resourceId   String?        @map("resource_id") @db.Uuid
  summary      String?
  // 비밀번호·토큰·연락처 원문은 넣지 않는다
  before       Json?
  after        Json?
  requestId    String?        @map("request_id") @db.Uuid
  ip           String?
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

// 요청 한도(rate limit) 카운터. 서버리스 환경이라 메모리에 못 두고 DB에 둔다
// (노션 4번 인증 방식 4장). id 예: "login:user@example.com:203.0.113.10".
// 고정 윈도우(fixed window) 방식 — src/middlewares/rateLimiter.js가 읽고 쓴다.
model RateLimit {
  id          String   @id
  count       Int      @default(0)
  windowStart DateTime @map("window_start") @db.Timestamptz(3)
  expiresAt   DateTime @map("expires_at") @db.Timestamptz(3)

  @@map("rate_limits")
}

// 플랫폼 운영 설정(키·값). 값은 문자열로 두고 읽는 쪽이 검사한다.
model PlatformSetting {
  key       String   @id @db.VarChar(60)
  value     String
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("platform_settings")
}

// 권리자 인증 시도. 진행 중(PENDING·RUNNING)은 소유 관계마다 1건 — uq_verification_attempt_active (마이그레이션 SQL)
model OwnershipVerificationAttempt {
  id           String                    @id @default(uuid()) @db.Uuid
  ownershipId  String                    @map("ownership_id") @db.Uuid
  ownership    Ownership                 @relation(fields: [ownershipId], references: [id])
  requestedBy  String                    @map("requested_by") @db.Uuid
  requester    User                      @relation(fields: [requestedBy], references: [id])
  status       VerificationAttemptStatus @default(PENDING)
  // 상세 사유 코드(계획 5장). 관리자 화면과 감사 로그에만 나간다.
  reasonCode   String?                   @map("reason_code") @db.VarChar(40)
  ledgerKind   String?                   @map("ledger_kind") @db.VarChar(20)
  ownerCount   Int?                      @map("owner_count")
  createdAt    DateTime                  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime                  @default(now()) @map("updated_at") @db.Timestamptz(3)
  finishedAt   DateTime?                 @map("finished_at") @db.Timestamptz(3)

  @@index([ownershipId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("ownership_verification_attempts")
}

// ===== B팀/C팀 전용 모델은 이 아래에 각자 주석 블록으로 추가 (schema.prisma 충돌 방지) =====

// ===== C팀: 임대차 분쟁 해결사 (disputes) =====
// 분쟁 참고자료(조정사례·판례·가이드라인). 시드로만 채운다(prisma/seedDisputes.js).
// Core 모델과 relation 없음 (노션 5번 API Spec 6장).

enum DisputeReferenceType {
  CASE // 분쟁조정 사례
  PRECEDENT // 판례
  GUIDELINE // 제도 안내·FAQ

  @@map("dispute_reference_type")
}

enum DisputePropertyKind {
  HOUSING // 주택
  COMMERCIAL // 상가건물

  @@map("dispute_property_kind")
}

// 주택·상가건물 임대차보호법 시행령의 분쟁조정 대상 유형
enum DisputeCategory {
  RENT_ADJUSTMENT // 차임 또는 보증금의 증감
  LEASE_TERM // 임대차 기간
  DEPOSIT_RETURN // 보증금 또는 임차목적물의 반환
  REPAIR_DUTY // 유지·수선의무
  CONTRACT_INTERPRETATION // 계약 이행 및 내용의 해석
  RENEWAL_TERMINATION // 계약 갱신 및 종료
  DAMAGES // 손해배상
  BROKERAGE_FEE // 중개사 보수 등 비용 부담
  PREMIUM // 권리금 (상가)
  GENERAL // 제도 일반

  @@map("dispute_category")
}

model DisputeReference {
  id           String               @id @default(uuid()) @db.Uuid
  sourceKey    String               @unique @map("source_key") // 시드 upsert 키, 예: "casebook-2025-H-01-1"
  type         DisputeReferenceType
  propertyKind DisputePropertyKind? @map("property_kind") // null이면 주택·상가 공통
  category     DisputeCategory
  title        String
  summary      String // 목록에 보이는 쟁점 요약
  content      String // 사실관계·당사자 주장·검토 등 본문
  outcome      String? // 조정 결과 / 판결 요지 (가이드라인은 null)
  caseNumber   String?              @map("case_number") // 판례 사건번호
  relatedLaws  String[]             @map("related_laws")
  keywords     String[]
  sourceTitle  String               @map("source_title")
  sourcePage   Int?                 @map("source_page")
  // 챗봇 RAG 검색용 임베딩(Gemini gemini-embedding-001, 768차원). 시드 후 embed:disputes로 채운다.
  // pgvector 타입이라 Prisma Client로 읽고 쓰지 못하고 raw SQL을 쓴다(domains/disputes/service.js).
  embedding    Unsupported("vector(768)")?
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([type, category])
  @@map("dispute_references")
}

// 분쟁 상담 챗봇 대화 기록 (챗봇 대화 기록은 피처 소유).
// userId는 User와 relation을 걸지 않는다 — 걸면 A팀 User 모델에 반대쪽 필드를 추가해야 하고,
// 지금 로그인 유저는 fixture라 users에 없어서 FK를 걸면 저장이 실패한다.

enum DisputeChatRole {
  USER
  ASSISTANT

  @@map("dispute_chat_role")
}

model DisputeChat {
  id        String               @id @default(uuid()) @db.Uuid
  userId    String               @map("user_id") @db.Uuid
  title     String // 첫 질문 앞부분
  messages  DisputeChatMessage[]
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([userId, updatedAt])
  @@map("dispute_chats")
}

model DisputeChatMessage {
  id           String          @id @default(uuid()) @db.Uuid
  chatId       String          @map("chat_id") @db.Uuid
  chat         DisputeChat     @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role         DisputeChatRole
  content      String // 답변 본문. 근거 표시는 [1], [2]처럼 referenceIds 순서를 가리킨다.
  referenceIds String[]        @map("reference_ids") @db.Uuid // 답변 근거로 쓴 DisputeReference id (USER 메시지는 빈 배열)
  // Claude API 사용량. ASSISTANT 메시지에만 채운다(USER는 null) — 비용 추적용
  inputTokens  Int?            @map("input_tokens")
  outputTokens Int?            @map("output_tokens")
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([chatId, createdAt])
  @@map("dispute_chat_messages")
}

// ===== C팀 끝 =====

// ===== B팀: 임대인 커뮤니티 (community) =====
// 법정동 단위 게시판·투표·뉴스. 경로 /community · 테이블 community_* · 에러 COMMUNITY_*
// (api-contract.md 9장 "임대인 커뮤니티"). 실거래 데이터는 플랫폼 시세 API로만 — 자체 적재 테이블 없음.
// RLS·전국 기사 부분 유니크 인덱스·CHECK 제약 2개는 Prisma 로 표현할 수 없어 마이그레이션 SQL 에 직접 넣었다
// (migrations/*_add_community/migration.sql 끝).

// ── Core 모델과 relation 을 걸지 않는 이유 ───────────────────────────────────
// Prisma 의 relation 은 양쪽에 필드가 필요하다. CommunityPost.author 를 만들려면
// User 에 communityPosts 를 추가해야 하는데, 그러면 Core 블록을 고치게 되어
// 팀 블록을 나눠 둔 의미(schema.prisma 충돌 방지)가 사라진다.
//
// 그래서 userId · legalDongCode · complexId 는 전부 관계 없는 스칼라로 둔다.
// 존재 검증과 표시용 정보는 플랫폼 조회 기능으로 해결한다
// (getUserSummary, GET /regions/:legalDongCode 등 — api-contract.md 9장 허용 목록).
// FK 가 없으므로 참조 무결성은 애플리케이션이 책임진다.
// ────────────────────────────────────────────────────────────────────────────


// ===== enum =====

enum CommunityPostCategory {
  FREE // 자유
  MARKET // 시세·거래
  MAINTENANCE // 수선·관리
  POLICY // 정책·세금

  @@map("community_post_category")
}

enum CommunityReportReason {
  SPAM // 도배·스팸
  ABUSE // 욕설·비방
  ADVERTISEMENT // 광고·홍보
  PRIVACY // 개인정보 노출
  OTHER // 기타

  @@map("community_report_reason")
}

enum CommunityReportStatus {
  RECEIVED // 접수
  RESOLVED // 처리 완료
  DISMISSED // 기각

  @@map("community_report_status")
}

// 투표가 미치는 범위. 만드는 사람이 고르고 등록 후에는 바꿀 수 없다
// (참여 자격이 도중에 바뀌면 이미 던진 표의 자격이 사라져 집계가 깨진다).
enum CommunityPollScope {
  COMPLEX // 우리 단지 — 그 단지에 인증을 보유한 임대인만
  REGION // 법정동 — 그 동에 인증을 보유한 임대인 모두

  @@map("community_poll_scope")
}

enum CommunityNewsSource {
  NEWS_SEARCH // 뉴스 검색 기능으로 모은 지역 기사
  MOLIT_PRESS // 국토교통부 보도자료

  @@map("community_news_source")
}

enum CommunityNewsScope {
  NATIONWIDE // 전국 정책 — scopeCode 는 null
  SIGUNGU // 시·군·구 — scopeCode 는 법정동코드 앞 5자리
  SIDO // 시·도 — scopeCode 는 법정동코드 앞 2자리. 시·군·구 기사가 모자랄 때 채우는 묶음

  @@map("community_news_scope")
}


// ===== 게시판 =====

model CommunityPost {
  id            String                @id @default(uuid()) @db.Uuid
  legalDongCode String                @map("legal_dong_code") @db.VarChar(10)
  category      CommunityPostCategory
  title         String                @db.VarChar(100)
  body          String

  authorId String @map("author_id") @db.Uuid
  // 작성 시점의 표기를 굳혀 둔다(예: "잠실한빛아파트 103동 임대인").
  // 작성자가 그 호실을 팔아도 과거 글의 표기는 바뀌지 않아야 하고,
  // 목록을 읽을 때마다 소유 관계를 조인하지 않아도 된다.
  authorLabel String @map("author_label")

  // 목록에서 매번 세지 않도록 둔 값. 댓글 등록·삭제와 같은 트랜잭션에서 고친다.
  commentCount Int @default(0) @map("comment_count")

  // 작성자 삭제: 표시만 남기고 내용은 비노출
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)
  // 운영자 숨김: 목록·상세에서 비노출
  hiddenAt       DateTime? @map("hidden_at") @db.Timestamptz(3)
  hiddenByUserId String?   @map("hidden_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  comments CommunityComment[]
  reports  CommunityReport[]

  // 목록 기본 질의: 법정동 + 분류 + 최신순
  @@index([legalDongCode, category, createdAt(sort: Desc)])
  // "내 글만 보기" 필터
  @@index([legalDongCode, authorId, createdAt(sort: Desc)])
  @@map("community_posts")
}

model CommunityComment {
  id     String        @id @default(uuid()) @db.Uuid
  postId String        @map("post_id") @db.Uuid
  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  body String @db.VarChar(1000)

  authorId    String @map("author_id") @db.Uuid
  authorLabel String @map("author_label")

  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  hiddenAt       DateTime? @map("hidden_at") @db.Timestamptz(3)
  hiddenByUserId String?   @map("hidden_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  reports CommunityReport[]

  // 상세 화면: 글 하나의 댓글을 오름차순
  @@index([postId, createdAt])
  @@index([authorId])
  @@map("community_comments")
}

// 글과 댓글을 한 테이블로 받는다. 둘 중 하나만 채워진다
// (CHECK 제약은 마이그레이션 SQL 에 직접 — add_community migration.sql 끝).
model CommunityReport {
  id String @id @default(uuid()) @db.Uuid

  postId String?        @map("post_id") @db.Uuid
  post   CommunityPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  commentId String?           @map("comment_id") @db.Uuid
  comment   CommunityComment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  reporterId String                @map("reporter_id") @db.Uuid
  reason     CommunityReportReason
  detail     String?               @db.VarChar(500)

  status          CommunityReportStatus @default(RECEIVED)
  handledAt       DateTime?             @map("handled_at") @db.Timestamptz(3)
  handledByUserId String?               @map("handled_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // 같은 대상 중복 신고 차단.
  // PostgreSQL 은 UNIQUE 안의 NULL 을 서로 다른 값으로 보기 때문에,
  // 댓글 신고(post_id = NULL)끼리는 이 제약에 걸리지 않는다 — 그쪽은 아래 제약이 맡는다.
  @@unique([postId, reporterId])
  @@unique([commentId, reporterId])
  // 운영자 콘솔 목록: 상태 + 접수순
  @@index([status, createdAt])
  @@map("community_reports")
}


// ===== 투표 =====

model CommunityPoll {
  id    String             @id @default(uuid()) @db.Uuid
  scope CommunityPollScope

  // 범위와 무관하게 항상 채운다. COMPLEX 범위일 때는 그 단지가 속한 법정동.
  legalDongCode String @map("legal_dong_code") @db.VarChar(10)
  // scope = COMPLEX 일 때만 채운다 (CHECK 제약은 마이그레이션 SQL 에 직접).
  complexId String? @map("complex_id") @db.Uuid

  title       String  @db.VarChar(100)
  description String?

  authorId    String @map("author_id") @db.Uuid
  authorLabel String @map("author_label")

  closesAt DateTime @map("closes_at") @db.Timestamptz(3)
  // 마감 배치(cron)가 채운다. 색인·정렬을 맞추는 용도다.
  // 마감 판정은 `closedAt != null || closesAt <= now` 다 — closedAt 만 보면
  // cron 이 돌기 전까지 결과가 열리지 않는다. 서버 시계 차이는 초 단위라 실익이 작다.
  closedAt DateTime? @map("closed_at") @db.Timestamptz(3)

  // 참여자 수. 투표와 같은 트랜잭션에서 올린다.
  voteCount Int @default(0) @map("vote_count")

  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)
  hiddenAt       DateTime? @map("hidden_at") @db.Timestamptz(3)
  hiddenByUserId String?   @map("hidden_by_user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  options CommunityPollOption[]

  // 목록: 법정동 + 진행중/마감 + 마감일순
  @@index([legalDongCode, closedAt, closesAt])
  // "우리 단지" 필터
  @@index([complexId, closesAt])
  // 마감 배치가 훑는 질의
  @@index([closedAt, closesAt])
  @@map("community_polls")
}

model CommunityPollOption {
  id     String        @id @default(uuid()) @db.Uuid
  pollId String        @map("poll_id") @db.Uuid
  poll   CommunityPoll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  label    String @db.VarChar(80)
  position Int

  voteCount Int @default(0) @map("vote_count")

  votes CommunityPollVote[]

  // 아래 CommunityPollVote 의 복합 FK 가 참조하는 대상.
  // 이게 있어야 "다른 투표의 선택지에 표를 던지는" 일이 DB 차원에서 막힌다.
  @@unique([id, pollId])
  @@unique([pollId, position])
  @@map("community_poll_options")
}

model CommunityPollVote {
  id String @id @default(uuid()) @db.Uuid

  // pollId 는 두 가지 일을 한다.
  //   1) 아래 복합 FK 로 "이 선택지가 정말 이 투표의 것인지"를 DB 가 검사하게 하고
  //   2) 1인 1표 유니크의 한쪽이 된다.
  // CommunityPoll 로 가는 별도 relation 은 두지 않는다 — 같은 스칼라를 두 relation 에
  // 쓰면 Prisma 가 거부하고, 집계는 voteCount 로 하므로 필요도 없다.
  pollId   String              @map("poll_id") @db.Uuid
  optionId String              @map("option_id") @db.Uuid
  option   CommunityPollOption @relation(fields: [optionId, pollId], references: [id, pollId], onDelete: Cascade)

  voterId String @map("voter_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  // 1인 1표. 같은 범위에 여러 호실을 보유해도 한 표.
  // 애플리케이션 검사만 믿지 않고 DB 로 강제한다.
  @@unique([pollId, voterId])
  @@index([optionId])
  @@map("community_poll_votes")
}


// ===== 뉴스 =====

model CommunityNewsItem {
  id     String              @id @default(uuid()) @db.Uuid
  source CommunityNewsSource
  scope  CommunityNewsScope
  // SIGUNGU 면 법정동코드 앞 5자리, SIDO 면 앞 2자리, NATIONWIDE 면 null
  scopeCode String? @map("scope_code") @db.VarChar(5)

  title     String
  url       String
  // 원문 URL 의 sha-256. url 에 직접 유니크를 걸면 길이 한도에 걸릴 수 있다.
  urlHash   String  @map("url_hash") @db.VarChar(64)
  publisher String?

  publishedAt DateTime @map("published_at") @db.Timestamptz(3)
  collectedAt DateTime @default(now()) @map("collected_at") @db.Timestamptz(3)

  // 같은 범위 안에서만 중복을 막는다. 전국 기사와 지역 기사가 같은 URL 이어도
  // 둘 다 남는다 — 범위가 다르면 다른 목록에 뜨기 때문.
  //
  // ⚠️ 이 제약만으로는 전국 기사(scopeCode = NULL)의 중복이 막히지 않는다.
  //    PostgreSQL 이 UNIQUE 안의 NULL 을 서로 다른 값으로 보기 때문이다.
  //    부분 유니크 인덱스를 마이그레이션 SQL 에 직접 넣는다 (add_community migration.sql 끝).
  @@unique([scopeCode, urlHash])
  @@index([scope, scopeCode, publishedAt(sort: Desc)])
  @@map("community_news_items")
}
// ===== B팀 끝 =====
