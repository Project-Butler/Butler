generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  LANDLORD
  TENANT
  ADMIN
}

// 소유 관계 인증 상태. EXPIRED는 여기 없다 — verificationExpiresAt이 지나면
// 응답을 만들 때 계산해서 EXPIRED로 내려준다 (src/platform/ownershipStatus.js)
enum OwnershipVerificationStatus {
  UNVERIFIED
  VERIFIED
  REVOKED
}

enum OwnershipEndReason {
  SELF_ENDED
  SUPERSEDED
  ADMIN_ENDED
}

enum LeaseType {
  MONTHLY
  JEONSE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  DONE
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String
  role      Role
  createdAt DateTime @default(now())

  ownerships      PropertyOwnership[]
  tenantContracts Contract[]          @relation("TenantContracts")
}

// 법정동. 행정안전부 "법정동코드 전체자료"로 셋업 시점에 시딩한다(prisma/seed.js).
// 조회 API에서 Region을 만드는 경로는 없다 — lazy 생성하지 않는다.
model Region {
  legalDongCode String @id
  sidoName      String
  sigunguName   String
  dongName      String
  fullName      String

  complexes Complex[]
}

model Complex {
  id            String  @id @default(uuid())
  sourceKey     String? @unique
  name          String
  jibunAddress  String?
  roadAddress   String?
  legalDongCode String
  region        Region  @relation(fields: [legalDongCode], references: [legalDongCode])

  // buildingInfo — 외부 데이터에 없으면 전부 null. AMI 등 나중 기능이 입력으로 씀.
  approvalDate   DateTime? @db.Date
  householdCount Int?
  buildingCount  Int?
  maxFloor       Int?
  parkingCount   Int?

  createdAt DateTime @default(now())

  properties Property[]
}

model Property {
  id            String   @id @default(uuid())
  complexId     String
  complex       Complex  @relation(fields: [complexId], references: [id])
  buildingNo    String
  unitNo        String
  exclusiveArea Float?
  floor         Int?
  createdAt     DateTime @default(now())

  ownerships PropertyOwnership[]
  tickets    Ticket[]
  documents  Document[]

  // 같은 단지·동·호는 한 Property로 합친다(POST /properties가 이 키로 찾아 재사용).
  @@unique([complexId, buildingNo, unitNo])
}

model PropertyOwnership {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  acquiredYearMonth String?
  purchasePrice     BigInt?

  verificationStatus    OwnershipVerificationStatus @default(UNVERIFIED)
  verifiedAt            DateTime?
  verificationExpiresAt DateTime?

  startedAt DateTime            @default(now())
  endedAt   DateTime?
  endReason OwnershipEndReason?

  contracts Contract[]

  @@index([propertyId])
  @@index([userId])
}

model Contract {
  id          String            @id @default(uuid())
  ownershipId String
  ownership   PropertyOwnership @relation(fields: [ownershipId], references: [id])

  // 임차인이 초대를 수락하기 전까지 tenantId는 null. tenantName/tenantPhone은
  // 임대인이 등록 시점에 입력하는 값이라 계정과 별개로 항상 저장한다.
  tenantId    String?
  tenant      User?   @relation("TenantContracts", fields: [tenantId], references: [id])
  tenantName  String
  tenantPhone String

  leaseType   LeaseType
  deposit     BigInt
  monthlyRent BigInt

  startDate DateTime @db.Date
  endDate   DateTime @db.Date

  // status는 저장하지 않는다 — terminatedOn 유무 + 오늘(KST) 날짜로 응답마다 계산한다.
  // (src/platform/contractStatus.js의 computeContractStatus 참고)
  terminatedOn      DateTime? @db.Date
  terminationReason String?

  previousContractId String?
  memo                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownershipId])
  @@index([tenantId])
}

model Ticket {
  id          String       @id @default(uuid())
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id])
  title       String
  description String
  status      TicketStatus @default(OPEN)
  createdAt   DateTime     @default(now())
}

model Document {
  id         String   @id @default(uuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id])
  fileUrl    String
  type       String
  uploadedAt DateTime @default(now())
}

// 요청 한도(rate limit) 카운터. 서버리스 환경이라 메모리에 못 두고 DB에 둔다
// (api-contract.md 1장 "요청 한도"). key 예: "login:user@example.com:203.0.113.10".
// 고정 윈도우(fixed window) 방식 — src/middlewares/rateLimiter.js가 읽고 쓴다.
model RateLimitCounter {
  key         String   @id
  count       Int      @default(0)
  windowStart DateTime
}

// ===== B팀/C팀 전용 모델은 이 아래에 각자 주석 블록으로 추가 (schema.prisma 충돌 방지) =====

// ===== C팀: 임대차 분쟁 해결사 (disputes) =====
// 분쟁 참고자료(조정사례·판례·가이드라인). 시드로만 채운다(prisma/seedDisputes.js).
// Core 모델과 relation 없음 (api-contract.md 9장 "임대차 분쟁 해결사").

enum DisputeReferenceType {
  CASE // 분쟁조정 사례
  PRECEDENT // 판례
  GUIDELINE // 제도 안내·FAQ
}

enum DisputePropertyKind {
  HOUSING // 주택
  COMMERCIAL // 상가건물
}

// 주택·상가건물 임대차보호법 시행령의 분쟁조정 대상 유형
enum DisputeCategory {
  RENT_ADJUSTMENT // 차임 또는 보증금의 증감
  LEASE_TERM // 임대차 기간
  DEPOSIT_RETURN // 보증금 또는 임차목적물의 반환
  REPAIR_DUTY // 유지·수선의무
  CONTRACT_INTERPRETATION // 계약 이행 및 내용의 해석
  RENEWAL_TERMINATION // 계약 갱신 및 종료
  DAMAGES // 손해배상
  BROKERAGE_FEE // 중개사 보수 등 비용 부담
  PREMIUM // 권리금 (상가)
  GENERAL // 제도 일반
}

model DisputeReference {
  id           String               @id @default(uuid())
  sourceKey    String               @unique // 시드 upsert 키, 예: "casebook-2025-H-01-1"
  type         DisputeReferenceType
  propertyKind DisputePropertyKind? // null이면 주택·상가 공통
  category     DisputeCategory
  title        String
  summary      String // 목록에 보이는 쟁점 요약
  content      String // 사실관계·당사자 주장·검토 등 본문
  outcome      String? // 조정 결과 / 판결 요지 (가이드라인은 null)
  caseNumber   String? // 판례 사건번호
  relatedLaws  String[]
  keywords     String[]
  sourceTitle  String
  sourcePage   Int?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([type, category])
  @@map("dispute_references")
}
