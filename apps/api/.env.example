# apps/api 로컬 개발용 환경 변수 예시.
# 이 파일을 같은 폴더에 .env로 복사해서 쓴다: cp .env.example .env
# .env는 절대 커밋하지 않는다(.gitignore, hook이 막는다).

PORT=4000
NODE_ENV=development

# 로컬 Docker Postgres(루트 docker-compose.yml). 로컬에서는 두 값이 같다.
# 배포(Supabase)에서는 DATABASE_URL이 pooler(6543, ?pgbouncer=true&connection_limit=1),
# DIRECT_URL이 직접 연결(5432)이다. Supabase 주소는 로컬 .env에 넣지 않는다.
DATABASE_URL="postgresql://butler:butler@localhost:5432/butler?schema=public"
DIRECT_URL="postgresql://butler:butler@localhost:5432/butler?schema=public"

# JWT 서명 키. 각자 새로 만들고, 두 값은 서로 달라야 한다.
# 생성: node -e "console.info(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# 개인정보(휴대폰 번호) 암호화 키 — AES-256-GCM, hex 64자. 각자 새로 만들고 JWT 키와 다르게 한다.
# 비어 있으면 휴대폰 번호를 넣은 회원가입이 500으로 실패한다(평문 저장을 막으려는 것). 바꾸면 기존 암호문은 복호화되지 않는다.
# 생성: node -e "console.info(require('crypto').randomBytes(32).toString('hex'))"
FIELD_ENCRYPTION_KEY=

# CORS 허용 origin (쉼표 구분). 프론트(apps/butler) 한 곳이라 5173 하나다.
FRONTEND_ORIGINS=http://localhost:5173

# 권리자 인증(B팀) — 세움터 발급과 OCR은 외부 발급 서버가 한다. API는 발급 요청을 보내고 서명된 결과를 받기만 한다.
# 아래 두 값이 모두 있어야 인증을 시작할 수 있다. 하나라도 비어 있으면 인증 시작이 503(VERIFICATION_RUNNER_UNAVAILABLE)으로 거절되고 시도가 저장되지 않는다.
# 배포 환경 값은 Vercel에서 따로 정한다.
# API가 발급 요청을 보내는 외부 발급 서버 주소(POST {주소}/jobs). 발급 서버는 결과를 POST /api/v1/ownership-verifications/:id/result로 돌려보낸다.
OWNERSHIP_VERIFICATION_RUNNER_URL=
# API와 발급 서버가 양방향 HMAC-SHA256 서명에 함께 쓰는 비밀값. 양쪽에 같은 값을 넣는다.
# 생성: node -e "console.info(require('crypto').randomBytes(32).toString('hex'))"
OWNERSHIP_VERIFICATION_RUNNER_SECRET=

# 공공데이터 API 키 — 서버 전용. 프론트 .env에 VITE_ 접두어로 넣지 않는다(브라우저에 노출됨).
# 키는 각자 발급해서 넣는다. 채팅·문서에 키 값을 붙여 넣지 않는다.
# JUSO_API_KEY: 행안부 도로명주소 검색 API 승인키(confmKey). business.juso.go.kr › API 신청 › 검색API(도로명주소)에서 발급.
# 비어 있으면 주소 검색(GET /complexes/search)이 503을 반환한다. 이미 확정된 단지의 건물·호실 등록·조회는 영향 없다.
JUSO_API_KEY=
# DATA_GO_KR_SERVICE_KEY: data.go.kr 일반 인증키 중 Decoding 키. data.go.kr에서 아래 두 API를 활용 신청한다.
#   국토교통부_공동주택 단지 목록제공 서비스(AptListService4), 국토교통부_공동주택 기본 정보제공 서비스(AptBasisInfoServiceV5)
# 비어 있으면 K-apt 동기화(cron·sync:kapt·backfill:kapt-basis)만 실패한다. 주소 검색은 juso만 불러서 영향 없다.
DATA_GO_KR_SERVICE_KEY=
# 외부 API 호출 타임아웃(ms). K-apt(cron·백필) 공용 8초
EXTERNAL_API_TIMEOUT_MS=8000
# juso 주소 검색 타임아웃(ms). 요청 경로에서 부르므로 짧게, 재시도 없음
JUSO_TIMEOUT_MS=3000

# JUSO_LINK_API_KEY: 도로명주소 변동자료 공식 연계 승인키(app_key). 검색용 JUSO_API_KEY와 다른 키.
#   business.juso.go.kr › 주소정보 데이터 연계 › 데이터 연계신청(민간기관, [공개] 주소정보(속성), 인터넷 망)에서 발급.
# juso 매일 갱신의 유일한 경로다. 비어 있으면 매일 갱신이 실패로 남는다(jobs FAILED). 서버·주소 검색·등록은 영향 없다.
JUSO_LINK_API_KEY=

# Vercel Cron 인증 값(GET /api/cron/kapt-complexes 주간 K-apt 목록 동기화, GET /api/cron/reference-data 매일 juso 변동분·새 K-apt 단지).
# Vercel 프로젝트 환경 변수에도 같은 이름으로 넣는다 — Vercel이 cron 요청에 Authorization: Bearer <값>을 붙인다.
# 비워 두면 cron 경로가 404로 숨겨진다. 생성: node -e "console.info(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# 단지 검색 결과에 K-apt 단지명·분양형태를 붙일지(기본 on). off면 연결 조회를 건너뛰고 kapt: null.
ADDRESS_KAPT_ENRICHMENT=on

# 분쟁 상담 챗봇(disputes)의 답변 모델: gemini | claude (기본 gemini). 키는 각자 발급해서 넣는다.
DISPUTE_CHATBOT_PROVIDER=gemini
# Gemini: https://aistudio.google.com 에서 발급(무료 티어). 모델을 비우면 gemini-3.5-flash
# 참고자료 검색(임베딩)도 Gemini를 쓰므로 답변 모델이 claude여도 이 키가 필요하다.
GEMINI_API_KEY=
GEMINI_MODEL=
# GEMINI_MODEL이 붐비거나(503) 실패하면 한 번 더 시도할 모델. 비우면 gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=
# 임베딩 모델을 바꾸면 npm run embed:disputes -w apps/api 를 다시 실행한다. 비우면 gemini-embedding-001
GEMINI_EMBEDDING_MODEL=
# Claude: https://console.anthropic.com 에서 발급(유료). 모델을 비우면 claude-opus-5-5
ANTHROPIC_API_KEY=
CLAUDE_MODEL=

# 문서·사진 첨부 저장소(#72, #116). local | supabase
#   local = 서버 디스크에 두는 임시 로컬 저장소(Vercel에서는 파일이 남지 않아 쓸 수 없다). 로컬 개발 기본값.
#   supabase = Supabase Storage 비공개 버킷. 배포(Vercel)에서 쓴다. 아래 SUPABASE_* 값이 필요하다.
# 비어 있거나 필요한 값이 없으면 업로드·다운로드가 503(STORAGE_UNAVAILABLE)이고, 관리 로그 글 작성은 그대로 된다.
STORAGE_DRIVER=local
# local 저장 폴더. 비우면 apps/api/.storage (gitignore). 파일 이름은 업로드 id라 원본 이름이 남지 않는다.
LOCAL_STORAGE_DIR=
# 업로드(15분)·다운로드(5분) 서명 주소의 HMAC 비밀값. 비어 있으면 local도 쓸 수 없다(503). 다른 키와 다르게 만든다.
# 생성: node -e "console.info(require('crypto').randomBytes(32).toString('hex'))"
STORAGE_SIGNING_SECRET=

# STORAGE_DRIVER=supabase일 때만 쓴다. 서버 전용 — 프론트 .env에 VITE_ 접두어로 넣지 않고, 채팅·문서에 값을 붙여 넣지 않는다.
# SUPABASE_URL: 프로젝트 주소(https://<ref>.supabase.co). Supabase 대시보드 › Project Settings › API.
SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY: service_role 키(또는 secret 키). RLS를 건너뛰는 키라 서버 환경 변수에만 둔다.
SUPABASE_SERVICE_ROLE_KEY=
# 비공개 버킷 이름. 비우면 documents. 객체 이름은 uploads/<업로드 id>다.
SUPABASE_STORAGE_BUCKET=

# 소셜 로그인(#35) — 구글·카카오. 키는 각자 발급해서 넣는다. 채팅·문서에 값을 붙여 넣지 않는다.
# 비어 있으면 /auth/oauth/* 가 503(OAUTH_UNAVAILABLE)이고 일반 로그인은 영향 없다.
# Google: console.cloud.google.com › API 및 서비스 › 사용자 인증 정보 › OAuth 클라이언트 ID(웹 애플리케이션)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Kakao: developers.kakao.com › 앱 › 카카오 로그인 활성화 · 동의항목(닉네임·이메일) · 보안(Client Secret 사용)
# KAKAO_CLIENT_ID는 REST API 키다.
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
# 제공자 콘솔의 Redirect URI는 {OAUTH_REDIRECT_BASE_URL}/api/v1/auth/oauth/{google|kakao}/callback 로 등록한다.
# 로컬: http://localhost:4000 (위 PORT와 같아야 한다). 운영은 반드시 https이고, 제공자 콘솔에 등록한 주소와 한 글자도 다르면 안 된다.
OAUTH_REDIRECT_BASE_URL=http://localhost:4000
# 로그인 결과를 돌려보낼 임대인 앱 주소(FRONTEND_ORIGINS의 landlord와 같다). 운영은 API와 같은 사이트(같은 상위 도메인)여야 쿠키가 따라간다.
OAUTH_FRONTEND_URL=http://localhost:5173

# 메일 발송(회원가입 이메일 인증번호, #78) — SMTP. 값은 각자 발급해서 넣고 채팅·문서에 붙여 넣지 않는다.
# SMTP_HOST가 비어 있으면 로컬에서는 메일 대신 서버 콘솔에 인증번호가 출력된다(production에서는 503 EMAIL_UNAVAILABLE).
# Gmail로 시험할 때: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=본인 Gmail 주소, SMTP_PASS=Google 계정 › 보안 › 앱 비밀번호(2단계 인증 필요)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# 보내는 사람 표시. 비우면 SMTP_USER를 쓴다. 예: Butler <noreply@example.com>
MAIL_FROM=
