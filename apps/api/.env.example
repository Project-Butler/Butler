# apps/api 로컬 개발용 환경 변수 예시.
# 이 파일을 같은 폴더에 .env로 복사해서 쓴다: cp .env.example .env
# .env는 절대 커밋하지 않는다(.gitignore, hook이 막는다).

PORT=4000
NODE_ENV=development

# 로컬 Docker Postgres(루트 docker-compose.yml). 로컬에서는 두 값이 같다.
# 배포(Supabase)에서는 DATABASE_URL이 pooler(6543, ?pgbouncer=true&connection_limit=1),
# DIRECT_URL이 직접 연결(5432)이다. Supabase 주소는 로컬 .env에 넣지 않는다.
DATABASE_URL="postgresql://butler:butler@localhost:5432/butler?schema=public"
DIRECT_URL="postgresql://butler:butler@localhost:5432/butler?schema=public"

# JWT 서명 키. 각자 새로 만들고, 두 값은 서로 달라야 한다.
# 생성: node -e "console.info(require('crypto').randomBytes(32).toString('hex'))"
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=

# CORS 허용 origin (쉼표 구분). landlord 5173, tenant 5174, admin 5175
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# 공공데이터 API 키 — 서버 전용. 프론트 .env에 VITE_ 접두어로 넣지 않는다(브라우저에 노출됨).
# 둘 중 하나라도 비어 있으면 단지 검색·등록이 503을 반환한다.
# JUSO_API_KEY: 행안부 도로명주소 검색 API 승인키(confmKey)
JUSO_API_KEY=
# DATA_GO_KR_SERVICE_KEY: data.go.kr 일반 인증키 중 Decoding 키(공동주택 단지 목록·기본 정보)
DATA_GO_KR_SERVICE_KEY=
# 외부 API 호출 타임아웃(ms). K-apt(cron·백필) 공용 8초
EXTERNAL_API_TIMEOUT_MS=8000
# juso 주소 검색 타임아웃(ms). 요청 경로에서 부르므로 짧게, 재시도 없음
JUSO_TIMEOUT_MS=3000

# Vercel Cron 인증 값(GET /api/cron/kapt-complexes 주간 K-apt 목록 동기화, GET /api/cron/reference-data 매일 juso 변동분·새 K-apt 단지).
# juso 변동분 받기 주소는 코드에 고정(로그인·키 없음, referenceData/jusoDelta.js)이라 따로 넣을 값이 없다.
# Vercel 프로젝트 환경 변수에도 같은 이름으로 넣는다 — Vercel이 cron 요청에 Authorization: Bearer <값>을 붙인다.
# 비워 두면 cron 경로가 404로 숨겨진다. 생성: node -e "console.info(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# 단지 검색 결과에 K-apt 단지명·분양형태를 붙일지(기본 on). off면 연결 조회를 건너뛰고 kapt: null.
ADDRESS_KAPT_ENRICHMENT=on

# 분쟁 상담 챗봇(disputes)의 답변 모델: gemini | claude (기본 gemini). 키는 각자 발급해서 넣는다.
DISPUTE_CHATBOT_PROVIDER=gemini
# Gemini: https://aistudio.google.com 에서 발급(무료 티어). 모델을 비우면 gemini-3.5-flash
# 참고자료 검색(임베딩)도 Gemini를 쓰므로 답변 모델이 claude여도 이 키가 필요하다.
GEMINI_API_KEY=
GEMINI_MODEL=
# GEMINI_MODEL이 붐비거나(503) 실패하면 한 번 더 시도할 모델. 비우면 gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=
# 임베딩 모델을 바꾸면 npm run embed:disputes -w apps/api 를 다시 실행한다. 비우면 gemini-embedding-001
GEMINI_EMBEDDING_MODEL=
# Claude: https://console.anthropic.com 에서 발급(유료). 모델을 비우면 claude-opus-5-5
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
