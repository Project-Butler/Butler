node_modules/
.env*
# 키 목록만 담은 예시 파일은 올린다 (값은 비우거나 로컬 기본값만)
!.env.example
dist/
build/

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Vercel (로컬 프로젝트 연동 정보, 사용자별로 다름)
.vercel/

# ESLint cache
.eslintcache

# Prisma (Prisma Client를 node_modules가 아닌 별도 경로로 생성하도록 설정할 경우 대비)
generated/

# 테스트 커버리지 리포트 (추후 테스트 러너 도입 시)
coverage/

.claude/

docs/
# 대용량 원본 데이터 (juso 건물DB zip, K-apt 기본정보 엑셀 등). DB에 적재해 쓰고 레포에 넣지 않는다.
*.zip
*.xlsx
*.xls
# 테스트용 juso 변동분 샘플(1KB 미만)은 레포에 둔다 — 없으면 jusoFiles.test.js가 실패한다.
!apps/api/src/referenceData/fixtures/*.zip

# 문서 첨부 임시 로컬 저장소(STORAGE_DRIVER=local). 업로드한 파일이 들어간다.
apps/api/.storage/

# Playwright E2E 산출물과 세션 상태(쿠키가 들어 있다)
apps/butler/test-results/
apps/butler/test-results-prod/
apps/butler/playwright-report/
apps/butler/test/e2e/.auth/
